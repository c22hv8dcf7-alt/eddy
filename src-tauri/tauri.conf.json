{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "height": 900,
        "label": "main",
        "minHeight": 700,
        "minWidth": 1100,
        "resizable": true,
        "title": "Eddy",
        "width": 1440
      }
    ],
    "withGlobalTauri": true
  },
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": [
      "dmg",
      "app"
    ]
  },
  "identifier": "com.eddy.counter",
  "productName": "Eddy",
  "version": "0.5.1",
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "dangerousInsecureTransportProtocol": true,
      "endpoints": [
        "http://localhost:3000/api/apps/eddy/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYxRDExOENCNzQ4M0U2MTYKUldRVzVvTjB5eGpSWWFqV2FUNzBXWFRuVGUxZlROZzFlVXVuby9zenJoR0IyQllQVVdLbzdjZUEK"
    }
  }
}
